<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="humanoid_xacro">

  <!-- Constants -->
  <xacro:property name="M_PI" value="3.1415926535897931" />
  <xacro:property name="torso_height" value="0.5" />
  <xacro:property name="torso_width" value="0.3" />
  <xacro:property name="torso_depth" value="0.2" />
  <xacro:property name="arm_length" value="0.3" />
  <xacro:property name="forearm_length" value="0.3" />
  <xacro:property name="leg_length" value="0.4" />
  <xacro:property name="shin_length" value="0.4" />
  <xacro:property name="head_radius" value="0.1" />

  <!-- Materials -->
  <material name="light_gray">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <material name="skin_color">
    <color rgba="0.9 0.8 0.6 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.2 0.2 1.0"/>
  </material>

  <!-- Macro for creating arm joints and links -->
  <xacro:macro name="arm" params="side parent xyz_offset shoulder_axis:=0 1 0 elbow_axis:=0 1 0">
    <!-- Shoulder joint -->
    <joint name="${side}_shoulder_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="${side}_upper_arm"/>
      <origin xyz="${xyz_offset}" rpy="0 0 0"/>
      <axis xyz="${shoulder_axis}"/>
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="20.0" velocity="1.0"/>
    </joint>

    <link name="${side}_upper_arm">
      <visual>
        <origin xyz="0 0 ${arm_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="${arm_length}"/>
        </geometry>
        <material name="blue"/>
      </visual>

      <collision>
        <origin xyz="0 0 ${arm_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="${arm_length}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 ${arm_length/2}" rpy="0 0 0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Elbow joint -->
    <joint name="${side}_elbow_joint" type="revolute">
      <parent link="${side}_upper_arm"/>
      <child link="${side}_lower_arm"/>
      <origin xyz="0 0 ${arm_length}" rpy="0 0 0"/>
      <axis xyz="${elbow_axis}"/>
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="20.0" velocity="1.0"/>
    </joint>

    <link name="${side}_lower_arm">
      <visual>
        <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="${forearm_length}"/>
        </geometry>
        <material name="blue"/>
      </visual>

      <collision>
        <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="${forearm_length}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.8"/>
        <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0"/>
        <inertia ixx="0.008" ixy="0.0" ixz="0.0" iyy="0.008" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Macro for creating leg joints and links -->
  <xacro:macro name="leg" params="side parent xyz_offset hip_axis:=0 1 0 knee_axis:=0 1 0">
    <!-- Hip joint -->
    <joint name="${side}_hip_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="${side}_upper_leg"/>
      <origin xyz="${xyz_offset}" rpy="0 0 0"/>
      <axis xyz="${hip_axis}"/>
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="30.0" velocity="1.0"/>
    </joint>

    <link name="${side}_upper_leg">
      <visual>
        <origin xyz="0 0 ${-leg_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.06" length="${leg_length}"/>
        </geometry>
        <material name="red"/>
      </visual>

      <collision>
        <origin xyz="0 0 ${-leg_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.06" length="${leg_length}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="2.0"/>
        <origin xyz="0 0 ${-leg_length/2}" rpy="0 0 0"/>
        <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.002"/>
      </inertial>
    </link>

    <!-- Knee joint -->
    <joint name="${side}_knee_joint" type="revolute">
      <parent link="${side}_upper_leg"/>
      <child link="${side}_lower_leg"/>
      <origin xyz="0 0 ${-leg_length}" rpy="0 0 0"/>
      <axis xyz="${knee_axis}"/>
      <limit lower="0" upper="${M_PI/2}" effort="30.0" velocity="1.0"/>
    </joint>

    <link name="${side}_lower_leg">
      <visual>
        <origin xyz="0 0 ${-shin_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="${shin_length}"/>
        </geometry>
        <material name="red"/>
      </visual>

      <collision>
        <origin xyz="0 0 ${-shin_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="${shin_length}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="1.5"/>
        <origin xyz="0 0 ${-shin_length/2}" rpy="0 0 0"/>
        <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Torso -->
  <link name="torso">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_width} ${torso_depth} ${torso_height}"/>
      </geometry>
      <material name="light_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_width} ${torso_depth} ${torso_height}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Head -->
  <joint name="torso_to_head" type="revolute">
    <parent link="torso"/>
    <child link="head"/>
    <origin xyz="0 0 ${torso_height/2 + head_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-M_PI/4}" upper="${M_PI/4}" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="head">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${head_radius}"/>
      </geometry>
      <material name="skin_color"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${head_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Arms -->
  <xacro:arm side="left" parent="torso" xyz_offset="${torso_width/2} 0.1 ${torso_height/4}"/>
  <xacro:arm side="right" parent="torso" xyz_offset="${torso_width/2} -0.1 ${torso_height/4}"/>

  <!-- Legs -->
  <xacro:leg side="left" parent="torso" xyz_offset="0 0.1 ${-torso_height/2}"/>
  <xacro:leg side="right" parent="torso" xyz_offset="0 -0.1 ${-torso_height/2}"/>

</robot>